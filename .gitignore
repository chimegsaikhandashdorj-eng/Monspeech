# Виртуал орчин — requirements.txt-ээс дахин үүсгэнэ
.venv/

# Python-ы завсрын файлууд
__pycache__/
*.py[cod]
*.egg-info/

# PyInstaller-ийн бүтээлт (tools\build_exe.ps1-ээр дахин үүсгэнэ)
build/
dist/

# Зөвхөн энэ компьютерт хамаарах тохиргоо
.claude/settings.local.json
skills-lock.json

# Засварлагчийн түр файлууд
.vscode/
.idea/
*.swp
